#include<stdio.h>
void main()
{
	int a[100],i,size,seven=0,sodd=0;
	printf("Enter the size of an array");
	scanf("%d",size);
	for(i=0;i<size;i++)
	printf("Enter %d element in array",i+1);
	scanf("%d",a[i]);
	for(i=0;i<size;i++)
	{
		if(a[i]%2==0)
		seven=seven+a[i];
		else
		sodd=sodd+a[i];
		
	}
	printf("sum of %d elements\n",seven);
	printf("sum of %d elements",sodd);
}
